##
## Code analysis (CAxxxx) rules
##
# All rules here https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/categories

### Design rules ###

# ✅ Good
dotnet_diagnostic.CA1000.severity = none # CA1000: Do not declare static members on generic types
dotnet_diagnostic.CA1001.severity = none # CA1001: Types that own disposable fields should be disposable
dotnet_diagnostic.CA1002.severity = none # CA1002: Do not expose generic lists
dotnet_diagnostic.CA1012.severity = none # CA1012: Abstract types should not have public constructors
dotnet_diagnostic.CA1018.severity = none # CA1018: Mark attributes with AttributeUsageAttribute
dotnet_diagnostic.CA1036.severity = none # CA1036: Override methods on comparable types
dotnet_diagnostic.CA1041.severity = none # CA1041: Provide ObsoleteAttribute message
dotnet_diagnostic.CA1043.severity = none # CA1043: Use integral or string argument for indexers
dotnet_diagnostic.CA1044.severity = none # CA1044: Properties should not be write only
dotnet_diagnostic.CA1047.severity = none # CA1047: Do not declare protected members in sealed types
dotnet_diagnostic.CA1050.severity = none # CA1050: Declare types in namespaces
dotnet_diagnostic.CA1051.severity = none # CA1051: Do not declare visible instance fields
dotnet_diagnostic.CA1053.severity = none # CA1053: Static holder types should not have default constructors
dotnet_diagnostic.CA1054.severity = none # CA1054: URI parameters should not be strings
dotnet_diagnostic.CA1055.severity = none # CA1055: URI return values should not be strings
dotnet_diagnostic.CA1056.severity = none # CA1056: URI properties should not be strings
dotnet_diagnostic.CA1061.severity = none # CA1061: Do not hide base class methods
dotnet_diagnostic.CA1063.severity = none # CA1063: Implement IDisposable correctly
dotnet_diagnostic.CA1064.severity = none # CA1064: Exceptions should be public
dotnet_diagnostic.CA1068.severity = none # CA1068: CancellationToken parameters must come last
dotnet_diagnostic.CA1069.severity = none # CA1069: Enums should not have duplicate values
dotnet_diagnostic.CA1070.severity = none # CA1070: Do not declare event fields as virtual

# ❌ Bad / Not for all apps
dotnet_diagnostic.CA1005.severity = none # CA1005: Avoid excessive parameters on generic types
dotnet_diagnostic.CA1008.severity = none # CA1008: Enums should have zero value
dotnet_diagnostic.CA1021.severity = none # CA1021: Avoid out parameters
dotnet_diagnostic.CA1024.severity = none # CA1024: Use properties where appropriate
dotnet_diagnostic.CA1027.severity = none # CA1027: Mark enums with FlagsAttribute
dotnet_diagnostic.CA1028.severity = none # CA1028: Enum storage should be Int32
dotnet_diagnostic.CA1030.severity = none # CA1030: Use events where appropriate
dotnet_diagnostic.CA1031.severity = none # CA1031: Do not catch general exception types
dotnet_diagnostic.CA1032.severity = none # CA1032: Implement standard exception constructors
dotnet_diagnostic.CA1040.severity = none # CA1040: Avoid empty interfaces
dotnet_diagnostic.CA1045.severity = none # CA1045: Do not pass types by reference
dotnet_diagnostic.CA1046.severity = none # CA1046: Do not overload operator equals on reference types
dotnet_diagnostic.CA1062.severity = none # CA1062: Validate arguments of public methods
dotnet_diagnostic.CA1019.severity = none # CA1019: Define accessors for attribute arguments
dotnet_diagnostic.CA1034.severity = none # CA1034: Nested types should not be visible
dotnet_diagnostic.CA1052.severity = none # CA1052: Static holder types should be Static or NotInheritable
dotnet_diagnostic.CA1065.severity = none # CA1065: Do not raise exceptions in unexpected locations

# ℹ️ You can turn it on or not.
dotnet_diagnostic.CA1010.severity = default # CA1010: Collections should implement generic interface
dotnet_diagnostic.CA1033.severity = default # CA1033: Interface methods should be callable by child types
dotnet_diagnostic.CA1058.severity = default # CA1058: Types should not extend certain base types
dotnet_diagnostic.CA1066.severity = default # CA1066: Implement IEquatable when overriding Equals

# ❓ Didn't work / didn't understand
dotnet_diagnostic.CA1003.severity = default # CA1003: Use generic event handler instances
dotnet_diagnostic.CA1014.severity = default # CA1014: Mark assemblies with CLSCompliantAttribute
dotnet_diagnostic.CA1016.severity = default # CA1016: Mark assemblies with AssemblyVersionAttribute
dotnet_diagnostic.CA1017.severity = default # CA1017: Mark assemblies with ComVisibleAttribute
dotnet_diagnostic.CA1060.severity = default # CA1060: Move P/Invokes to NativeMethods class


### Documentation rules ###

# ✅ Good
dotnet_diagnostic.CA1200.severity = none # CA1200: Avoid using cref tags with a prefix


### Globalization rules ###
# I haven't worked with multilingual apps, so it's hard to say what's useful and what's not.
dotnet_diagnostic.CA1303.severity = default # CA1303: Do not pass literals as localized parameters
dotnet_diagnostic.CA1304.severity = default # CA1304: Specify CultureInfo
dotnet_diagnostic.CA1305.severity = default # CA1305: Specify IFormatProvider
dotnet_diagnostic.CA1307.severity = default # CA1307: Specify StringComparison for clarity
dotnet_diagnostic.CA1308.severity = default # CA1308: Normalize strings to uppercase
dotnet_diagnostic.CA1309.severity = default # CA1309: Use ordinal StringComparison
dotnet_diagnostic.CA1310.severity = default # CA1310: Specify StringComparison for correctness
dotnet_diagnostic.CA1311.severity = default # CA1311: Specify a culture or use an invariant version
dotnet_diagnostic.CA2101.severity = default # CA2101: Specify marshalling for P/Invoke string arguments


### Portability and interoperability rules ###
# I haven't worked with cross-platform apps, so it's hard to say what's useful and what's not.
dotnet_diagnostic.CA1401.severity = default # CA1401: P/Invokes should not be visible
dotnet_diagnostic.CA1416.severity = default # CA1416: Validate platform compatibility
dotnet_diagnostic.CA1417.severity = default # CA1417: Do not use OutAttribute on string parameters for P/Invokes
dotnet_diagnostic.CA1418.severity = default # CA1418: Use valid platform string
dotnet_diagnostic.CA1419.severity = default # CA1419: Provide a parameterless constructor that is as visible as the containing type for concrete types derived from 'System.Runtime.InteropServices.SafeHandle'
dotnet_diagnostic.CA1420.severity = default # CA1420: Property, type, or attribute requires runtime marshalling
dotnet_diagnostic.CA1421.severity = default # CA1421: Method uses runtime marshalling when DisableRuntimeMarshallingAttribute is applied
dotnet_diagnostic.CA1422.severity = default # CA1422: Validate platform compatibility


### Maintainability rules ###

# ✅ Good
dotnet_diagnostic.CA1501.severity = none # CA1501: Avoid excessive inheritance
dotnet_diagnostic.CA1507.severity = none # CA1507: Use nameof in place of string
dotnet_diagnostic.CA1508.severity = none # CA1508: Avoid dead conditional code
dotnet_diagnostic.CA1509.severity = none # CA1509: Invalid entry in code metrics configuration file
dotnet_diagnostic.CA1510.severity = none # CA1510: Use ArgumentNullException throw helper
dotnet_diagnostic.CA1511.severity = none # CA1511: Use ArgumentException throw helper
dotnet_diagnostic.CA1512.severity = none # CA1512: Use ArgumentOutOfRangeException throw helper
dotnet_diagnostic.CA1513.severity = none # CA1513: Use ObjectDisposedException throw helper
dotnet_diagnostic.CA1514.severity = none # CA1514: Avoid redundant length argument

# ❌ Bad / Not for all apps
dotnet_diagnostic.CA1502.severity = none # CA1502: Avoid excessive complexity
dotnet_diagnostic.CA1505.severity = none # CA1505: Avoid unmaintainable code
dotnet_diagnostic.CA1506.severity = none # CA1506: Avoid excessive class coupling
dotnet_diagnostic.CA1515.severity = none # CA1515: Consider making public types internal

# ❓ Didn't work / didn't understand
dotnet_diagnostic.CA1516.severity = default # CA1516: Use cross-platform intrinsics


### Naming rules ###

# ✅ Good
dotnet_diagnostic.CA1708.severity = none # CA1708: Identifiers should differ by more than case
dotnet_diagnostic.CA1710.severity = none # CA1710: Identifiers should have correct suffix
dotnet_diagnostic.CA1712.severity = none # CA1712: Do not prefix enum values with type name
dotnet_diagnostic.CA1713.severity = none # CA1713: Events should not have before or after prefix
dotnet_diagnostic.CA1714.severity = none # CA1714: Flags enums should have plural names
dotnet_diagnostic.CA1715.severity = none # CA1715: Identifiers should have correct prefix
dotnet_diagnostic.CA1720.severity = none # CA1720: Identifiers should not contain type names
dotnet_diagnostic.CA1725.severity = none # CA1725: Parameter names should match base declaration

# ❌ Bad / Not for all apps
dotnet_diagnostic.CA1700.severity = none # CA1700: Do not name enum values 'Reserved'
dotnet_diagnostic.CA1707.severity = none # CA1707: Identifiers should not contain underscores
dotnet_diagnostic.CA1711.severity = none # CA1711: Identifiers should not have incorrect suffix
dotnet_diagnostic.CA1717.severity = none # CA1717: Only FlagsAttribute enums should have plural names
dotnet_diagnostic.CA1721.severity = none # CA1721: Property names should not match get methods
dotnet_diagnostic.CA1724.severity = none # CA1724: Type Names Should Not Match Namespaces
dotnet_diagnostic.CA1727.severity = none # CA1727: Use PascalCase for named placeholders
dotnet_diagnostic.CA1716.severity = none # CA1716: Identifiers should not match keywords
#dotnet_code_quality.CA1716.analyzed_symbol_kinds = Namespace, NamedType, Method, Property, Event


### Performance rules ###

# ✅ Good
dotnet_diagnostic.CA1802.severity = none # CA1802: Use Literals Where Appropriate
dotnet_diagnostic.CA1810.severity = none # CA1810: Initialize reference type static fields inline
dotnet_diagnostic.CA1812.severity = none # CA1812: Avoid uninstantiated internal classes
dotnet_diagnostic.CA1819.severity = none # CA1819: Properties should not return arrays
dotnet_diagnostic.CA1820.severity = none # CA1820: Test for empty strings using string length
dotnet_diagnostic.CA1821.severity = none # CA1821: Remove empty finalizers
dotnet_diagnostic.CA1823.severity = none # CA1823: Avoid unused private fields
dotnet_diagnostic.CA1825.severity = none # CA1825: Avoid zero-length array allocations
dotnet_diagnostic.CA1827.severity = none # CA1827: Do not use Count/LongCount when Any can be used
dotnet_diagnostic.CA1828.severity = none # CA1828: Do not use CountAsync/LongCountAsync when AnyAsync can be used
dotnet_diagnostic.CA1829.severity = none # CA1829: Use Length/Count property instead of Enumerable.Count method
dotnet_diagnostic.CA1830.severity = none # CA1830: Prefer strongly-typed Append and Insert method overloads on StringBuilder
dotnet_diagnostic.CA1831.severity = none # CA1831: Use AsSpan instead of Range-based indexers for string when appropriate
dotnet_diagnostic.CA1832.severity = none # CA1832: Use AsSpan or AsMemory instead of Range-based indexers for getting ReadOnlySpan or ReadOnlyMemory portion of an array
dotnet_diagnostic.CA1833.severity = none # CA1833: Use AsSpan or AsMemory instead of Range-based indexers for getting Span or Memory portion of an array
dotnet_diagnostic.CA1834.severity = none # CA1834: Use StringBuilder.Append(char) for single character strings
dotnet_diagnostic.CA1835.severity = none # CA1835: Prefer the memory-based overloads of ReadAsync/WriteAsync methods in stream-based classes
dotnet_diagnostic.CA1836.severity = none # CA1836: Prefer IsEmpty over Count when available
dotnet_diagnostic.CA1837.severity = none # CA1837: Use Environment.ProcessId instead of Process.GetCurrentProcess().Id
dotnet_diagnostic.CA1839.severity = none # CA1839: Use Environment.ProcessPath instead of Process.GetCurrentProcess().MainModule.FileName
dotnet_diagnostic.CA1840.severity = none # CA1840: Use Environment.CurrentManagedThreadId instead of Thread.CurrentThread.ManagedThreadId
dotnet_diagnostic.CA1841.severity = none # CA1841: Prefer Dictionary Contains methods
dotnet_diagnostic.CA1842.severity = none # CA1842: Do not use 'WhenAll' with a single task
dotnet_diagnostic.CA1843.severity = none # CA1843: Do not use 'WaitAll' with a single task
dotnet_diagnostic.CA1844.severity = none # CA1844: Provide memory-based overrides of async methods when subclassing 'Stream'
dotnet_diagnostic.CA1845.severity = none # CA1845: Use span-based 'string.Concat'
dotnet_diagnostic.CA1846.severity = none # CA1846: Prefer AsSpan over Substring
dotnet_diagnostic.CA1847.severity = none # CA1847: Use char literal for a single character lookup
dotnet_diagnostic.CA1849.severity = none # CA1849: Call async methods when in an async method
dotnet_diagnostic.CA1850.severity = none # CA1850: Prefer static HashData method over ComputeHash
dotnet_diagnostic.CA1853.severity = none # CA1853: Unnecessary call to 'Dictionary.ContainsKey(key)'
dotnet_diagnostic.CA1854.severity = none # CA1854: Prefer the 'IDictionary.TryGetValue(TKey, out TValue)' method
dotnet_diagnostic.CA1855.severity = none # CA1855: Use Span<T>.Clear() instead of Span<T>.Fill()
dotnet_diagnostic.CA1856.severity = none # CA1856: Incorrect usage of ConstantExpected attribute (already as error)
dotnet_diagnostic.CA1857.severity = none # CA1857: The parameter expects a constant for optimal performance
dotnet_diagnostic.CA1858.severity = none # CA1858: Use StartsWith instead of IndexOf
dotnet_diagnostic.CA1860.severity = none # CA1860: Avoid using 'Enumerable.Any()' extension method
dotnet_diagnostic.CA1861.severity = none # CA1861: Avoid constant arrays as arguments
dotnet_diagnostic.CA1863.severity = none # CA1863: Use 'CompositeFormat'
dotnet_diagnostic.CA1864.severity = none # CA1864: Prefer the 'IDictionary.TryAdd(TKey, TValue)' method
# CA1865-CA1867: Use 'string.Method(char)' instead of 'string.Method(string)' for string with single char
dotnet_diagnostic.CA1865.severity = none
dotnet_diagnostic.CA1866.severity = none
dotnet_diagnostic.CA1867.severity = none
dotnet_diagnostic.CA1868.severity = none # CA1868: Unnecessary call to 'Contains' for sets
dotnet_diagnostic.CA1869.severity = none # CA1869: Cache and reuse 'JsonSerializerOptions' instances
dotnet_diagnostic.CA1870.severity = none # CA1870: Use a cached 'SearchValues' instance
dotnet_diagnostic.CA1871.severity = none # CA1871: Do not pass a nullable struct to 'ArgumentNullException.ThrowIfNull'
dotnet_diagnostic.CA1872.severity = none # CA1872: Prefer 'Convert.ToHexString' and 'Convert.ToHexStringLower' over call chains based on 'BitConverter.ToString'

# ❌ Bad / Not for all apps
dotnet_diagnostic.CA1805.severity = none # CA1805: Do not initialize unnecessarily
dotnet_diagnostic.CA1806.severity = none # CA1806: Do not ignore method results
dotnet_diagnostic.CA1814.severity = none # CA1814: Prefer jagged arrays over multidimensional
dotnet_diagnostic.CA1815.severity = none # CA1815: Override equals and operator equals on value types
dotnet_diagnostic.CA1822.severity = none # CA1822: Mark members as static (none)
dotnet_diagnostic.CA1826.severity = none # CA1826: Use property instead of Linq Enumerable method
dotnet_diagnostic.CA1848.severity = none # CA1848: Use the LoggerMessage delegates
dotnet_diagnostic.CA1859.severity = none # CA1859: Use concrete types when possible for improved performance
dotnet_diagnostic.CA1852.severity = none # CA1852: Seal internal types
dotnet_diagnostic.CA1851.severity = none # CA1851: Possible multiple enumerations of IEnumerable collection
dotnet_diagnostic.CA1862.severity = none # CA1862: Use the 'StringComparison' method overloads to perform case-insensitive string comparisons

# ℹ️ You can turn it on or not.
dotnet_diagnostic.CA1813.severity = default # CA1813: Avoid unsealed attributes

# ❓ Didn't work / didn't understand
dotnet_diagnostic.CA1824.severity = default # CA1824: Mark assemblies with NeutralResourcesLanguageAttribute
dotnet_diagnostic.CA1838.severity = default # CA1838: Avoid StringBuilder parameters for P/Invokes


### SingleFile rules ###
# I've never worked with anything like this before, so it's hard to say whether it's useful or not.
dotnet_diagnostic.IL3000.severity = default # IL3000 Avoid accessing Assembly file path when publishing as a single file
dotnet_diagnostic.IL3001.severity = default # IL3001 Avoid accessing Assembly file path when publishing as a single file
