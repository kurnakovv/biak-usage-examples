dotnet_diagnostic.IL3005.severity = default # IL3005 RequiresAssemblyFilesAttribute cannot be placed directly on application entry point.


### Reliability rules ###

# ✅ Good
dotnet_diagnostic.CA2000.severity = none # CA2000: Dispose objects before losing scope
dotnet_diagnostic.CA2002.severity = none # CA2002: Do not lock on objects with weak identity
